{
  "format": "architecture-publications.question-table",
  "version": 2,
  "note": "Revised after the first three matrices (ETHOS 13 cited of 13, Film Kit 12, DDWG 12): ten of thirteen questions joined two or three clauses, and one answered clause made the whole entry count. Each entry now asks one thing. Entries marked for a genre apply to that genre only.",
  "entries": [
    {
      "id": "what-it-is",
      "lens": "product",
      "asks": ["evaluator", "newcomer"],
      "question": "What is this system?"
    },
    {
      "id": "for-whom",
      "lens": "product",
      "asks": ["evaluator"],
      "question": "Whom does it serve?"
    },
    {
      "id": "what-it-is-not",
      "lens": "product",
      "asks": ["evaluator", "newcomer"],
      "question": "What does it leave to others, and what is it not?"
    },
    {
      "id": "surroundings",
      "lens": "product",
      "asks": ["evaluator"],
      "question": "What does it work beside and depend on from outside?"
    },
    {
      "id": "goals",
      "lens": "product",
      "asks": ["evaluator"],
      "question": "What must it achieve, and who answers for it?"
    },
    {
      "id": "main-parts",
      "lens": "architecture",
      "asks": ["newcomer", "evaluator"],
      "question": "What are its main parts?"
    },
    {
      "id": "dependencies",
      "lens": "architecture",
      "asks": ["newcomer", "evaluator"],
