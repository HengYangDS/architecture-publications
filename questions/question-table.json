    {
      "id": "invariants",
      "lens": "architecture",
      "asks": ["newcomer", "evaluator"],
      "question": "What must always hold inside it?"
    },
    {
      "id": "never-break",
      "lens": "architecture",
      "asks": ["newcomer"],
      "question": "What must a change never break?"
    },
    {
      "id": "using-it",
      "lens": "project",
      "asks": ["newcomer"],
      "question": "How does one start using it?"
    },
    {
      "id": "changing-it",
      "lens": "project",
      "asks": ["newcomer"],
      "question": "How does one make a change to this repository?"
    },
    {
      "id": "verification",
      "lens": "project",
      "asks": ["newcomer", "evaluator"],
      "question": "How is a change verified?"
    },
    {
      "id": "release",
      "lens": "project",
      "asks": ["evaluator", "newcomer"],
      "question": "How is a release made?"
