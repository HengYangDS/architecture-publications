      "lens": "architecture",
      "asks": ["newcomer", "evaluator"],
      "question": "What data does it keep, and where?"
    },
    {
      "id": "interfaces",
      "lens": "architecture",
      "asks": ["newcomer", "evaluator"],
      "question": "Through which interfaces is it used and does it reach others?"
    },
    {
      "id": "built-with",
      "lens": "architecture",
      "asks": ["evaluator"],
      "question": "What is it built with?"
    },
    {
      "id": "installed-and-run",
      "lens": "architecture",
      "asks": ["evaluator", "newcomer"],
      "question": "How is it installed or distributed, and where does it run?"
    },
    {
      "id": "repository-structure",
      "lens": "architecture",
      "asks": ["newcomer"],
      "question": "Where in the repository does each part live?"
