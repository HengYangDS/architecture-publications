  "views": [
    {
      "id": "request-path",
      "title": "一轮 Responses 对话：从客户端到提供商",
      "question": "一轮 Responses 对话，从客户端到提供商要经过哪些部分？",
      "summary": "回环监听器把每一轮对话交给 Responses 转发，由它重建请求体并放行这一轮。上游交互经上游传输把请求发给提供商，响应投递再返回 JSON 或 SSE。",
      "members": [
        "client",
        "listener",
        "request-admission",
        "responses-relay",
        "replay-projection",
        "upstream-exchange",
        "upstream-transport",
        "response-delivery",
        "provider"
      ]
    },
    {
      "id": "portability",
      "title": "发往提供商的请求",
      "question": "请求怎样才能在提供商之间迁移？被拒的请求又怎样缩小？",
      "summary": "重放投影发送时设 store=false，不带 response、conversation 或缓存绑定，工具调用与输出始终配对。被拒的请求由限次恢复派生出严格更小、不拆配对的请求，再重新投影。",
      "members": [
        "responses-relay",
        "replay-projection",
        "agent-delivery",
        "bounded-recovery",
        "upstream-exchange",
        "response-delivery",
        "provider-registry"
      ]
    },
    {
      "id": "failures",
      "title": "失败按提供商隔离",
      "question": "上游失败如何重试、冷却和报告，而不耽误其他提供商？",
      "summary": "上游交互只在失败类别允许时重试；遇到 429 或重试耗尽的 503，只冷却出问题的那个提供商。遥测统计失败类别；上游传输绝不把完整发出的请求再发一次。",
      "members": [
        "upstream-exchange",
        "upstream-transport",
        "bounded-recovery",
        "provider-registry",
        "response-delivery",
        "telemetry",
        "provider"
      ]
    },
    {
      "id": "install",
      "title": "一次安装，一个事务",
      "question": "已签名的发布资产如何成为选定的一代？哪些可以回滚？",
      "summary": "发布版本准入先验证 SHA256SUMS.sig；记入日志的载荷事务把通过准入的字节落盘，成为新的一代。事务要么完结，要么回滚；代选择器至多保留一个前代。",
      "members": [
        "command-line",
        "lifecycle-commands",
        "release-admission",
        "payload-transaction",
        "owned-files",
        "generation-selector",
        "deployment",
        "runtime-settings"
      ]
    },
    {
      "id": "handoff",
      "title": "换新监听器，一轮也不丢",
      "question": "升级和重载如何把监听套接字移到新进程？",
      "summary": "监听器交接把监听套接字交给后继进程，期间准入一直开放；较旧的运行时则由部署排空后替换。事务完结之前，部署先证明后继进程的身份。",
      "members": [
        "deployment",
        "listener",
        "listener-handoff",
        "runtime-identity",
        "request-admission",
        "native-supervision",
        "generation-selector"
      ]
    },
    {
      "id": "supervision",
      "title": "由操作系统保持运行",
      "question": "谁启动监听器并让它持续运行？",
      "summary": "系统服务监管注册看门狗，由系统服务管理器启动它，并在它停止时重启。看门狗发现端口关闭就启动监听器，但有事务未结且尚未激活时会等待。",
      "members": [
        "native-supervision",
        "service-manager",
        "watchdog",
        "listener",
        "payload-transaction"
      ]
    }
