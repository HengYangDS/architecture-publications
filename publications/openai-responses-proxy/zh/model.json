  "overview": {
    "claim": "可移植的请求，事务化的安装",
    "lead": "面向 Codex 及其他 Responses 客户端的回环数据面：每个请求都按 store=false 重建，再发往路径所指的提供商；代理还负责安装、交接和监管自己的监听器。",
    "course": {
      "steps": [
        {
          "id": "route",
          "label": "一轮对话的路线",
          "note": "POST /<provider>/v1/responses 与 GET /<provider>/v1/models；其他路径一律在上游 I/O 之前拒绝",
          "stations": [
            {
              "id": "client",
              "label": "客户端",
              "note": "Codex、Hermes 或 Responses SDK"
            },
            {
              "id": "listener",
              "label": "监听器",
              "note": "127.0.0.1:8792，仅回环"
            },
            {
              "id": "body",
              "label": "请求体",
              "note": "单个 Content-Length，限 30 秒、64 MiB"
            },
            {
              "id": "projection",
              "label": "投影",
              "note": "store=false，去除提供商绑定"
            },
            {
              "id": "delegation",
              "label": "委派",
              "note": "Agent 消息仅在明文路由上可读"
            },
            {
              "id": "gate",
              "label": "冷却",
              "note": "提供商冷却期间拒绝请求"
            },
            {
              "id": "exchange",
              "label": "交互",
              "note": "单一时限，默认 900 秒"
            },
            {
              "id": "transport",
              "label": "传输",
              "note": "不跟随重定向；发出后无应答的请求绝不重发"
            }
          ],
          "view": "request-path"
        },
        {
          "id": "providers",
          "label": "提供商",
          "note": "每家一条路由，取自清单",
          "text": "清单指定每条路由的源站，以及报文策略（如有）。",
          "stations": [
            {
              "branches": [
                {
                  "id": "dmxapi",
                  "label": "dmxapi",
                  "note": "www.dmxapi.cn"
                },
                {
                  "id": "ucloud",
                  "label": "ucloud",
                  "note": "api.modelverse.cn"
                },
                {
                  "id": "aihubmix",
                  "label": "aihubmix",
                  "note": "api.inferera.com"
                },
                {
                  "id": "upstream",
                  "label": "upstream",
                  "note": "安装时选定的一个源站"
                }
              ]
            }
          ]
        }
      ],
      "lines": [
        {
          "from": "transport",
          "to": ["client"],
          "label": "“响应投递”逐个校验事件后才写出；内容之前的事件先暂存，其中若有 response.failed，还能重新发起请求。"
        }
      ]
    },
    "blocks": [
      {
        "title": "发往提供商的请求",
        "items": [
          ["保留", "对话消息、工具调用及其输出、本轮控制项、加密的 Agent 消息"],
          ["去除", "前一个 response 与 conversation 的绑定、缓存键、推理内容、条目引用、搜索调用"],
          ["改写", "空的工具输出改为一个标记；后到的工具结果改为注明归属的消息"],
          ["拒绝", "未知类型和残缺的工具配对，在任何上游 I/O 之前返回 400"]
        ],
        "view": "portability"
      },
      {
        "title": "每种失败只有一种应对，且有限度",
        "items": [
          ["429", "转发给客户端，不重试；仅该提供商按 Retry-After 冷却，至多 300 秒"],
          ["重试后的 503", "转发；该提供商短暂冷却，直到下一次探测"],
          ["DMXAPI 477", "完全匹配的 empty_response：用同样的字节重试一次"],
          ["response_failed", "逐步缩小、不拆配对地重试，最后再试一次只含对话的请求"],
          ["输入超长", "删减历史后改发一次更小的请求，保留本轮输入和图片"],
          ["发出后断连", "502 upstream_outcome_unknown；由客户端决定"],
          ["时限", "尚无内容送达时返回 504；否则关闭流，绝不重放"]
        ],
        "view": "failures"
      },
      {
        "title": "每次安装都是一个事务，全程写入事务日志",
        "stations": [
          {
            "id": "admitted",
            "label": "已准入",
            "note": "用 ssh-keygen 验证签名"
          },
          {
            "id": "prepared",
            "label": "已准备",
            "note": "每个文件及摘要都已写入事务日志"
          },
          {
            "id": "materialized",
            "label": "已落盘",
            "note": "新的一代，已预热"
          },
          {
            "id": "activated",
            "label": "已激活"
          },
          {
            "id": "finalized",
            "label": "已完结",
            "note": "监听器证明身份"
          }
        ],
        "aside": {
          "from": "activated",
          "label": "未确认：由 recover 完成或还原"
        },
        "text": "激活时切换命令链接和唯一的选择器，选择器指明当前代及其唯一的前代。回滚则是回到前代的一个新事务。",
        "view": "install"
      },
      {
        "title": "换新监听器，一轮也不丢",
        "stations": [
          {
            "id": "prepare",
            "label": "PREPARE",
            "note": "后继进程从选定的一代启动"
          },
          {
            "id": "ready",
            "label": "READY",
            "note": "继承套接字，回显身份"
          },
          {
            "id": "commit",
            "label": "COMMIT",
            "note": "旧监听器不再接受连接"
          },
          {
            "id": "serving",
            "label": "SERVING",
            "note": "经 /healthz 确认健康"
          },
          {
            "id": "finalize",
            "label": "FINALIZE",
            "note": "旧监听器处理完手上的各轮对话，至多 900 秒"
          }
        ],
        "text": "升级、回滚和重载都走这条路径。运行中的监听器若缺少任何一项交接能力，命令在改动之前就拒绝。",
        "view": "handoff"
      },
      {
        "title": "保持运行",
        "items": [
          ["系统服务管理器", "launchd、systemd 或任务计划程序重启看门狗"],
          ["看门狗", "每 15 秒检查端口；启动监听器"]
        ],
        "view": "supervision"
      },
      {
        "title": "命令",
        "items": [
          ["只读", "status 和 doctor 只读取，并给出下一条命令（如有）"],
          ["变更", "install、reload、rollback、recover 和 uninstall，一次一个"]
        ]
      },
      {
        "title": "不归代理管",
        "items": [
          ["客户端", "会话、工具状态和模型选择"],
          ["控制面", "凭据、提供商选择和客户端配置"]
        ]
      }
    ]
  },
