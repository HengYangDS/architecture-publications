  "views": [
    {
      "id": "request-path",
      "title": "一轮 Responses 对话：从客户端到提供商",
      "question": "这一轮对话途中依次由哪些组件处理？",
      "summary": "回环监听器把每一轮对话交给“Responses 转发”，由它重建请求体并放行。“上游交互”经“上游传输”把请求发给提供商，“响应投递”再返回 JSON 或 SSE。",
      "members": [
        "client",
        "listener",
        "request-admission",
        "responses-relay",
        "replay-projection",
        "upstream-exchange",
        "upstream-transport",
        "response-delivery",
        "provider"
      ]
    },
    {
      "id": "portability",
      "title": "发往提供商的请求",
      "question": "投影保留什么、去除什么？被提供商拒绝的请求如何缩小？",
      "summary": "“重放投影”设 store=false，去除与前一个 response、conversation 和缓存的绑定，工具调用与输出始终配对。被提供商拒绝的请求，由“限次恢复”派生出严格更小、不拆配对的请求，再逐个重建。",
      "members": [
        "responses-relay",
        "replay-projection",
        "agent-delivery",
        "bounded-recovery",
        "upstream-exchange",
        "response-delivery",
