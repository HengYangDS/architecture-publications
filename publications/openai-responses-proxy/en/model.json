  "components": [
    {
      "id": "client",
      "label": "Responses client",
      "kind": "client",
      "details": {
        "for example": "Codex, Hermes or a Responses SDK on a qualified route",
        "owns": "conversations, tool state and per-conversation model selection"
      }
    },
    {
      "id": "listener",
      "label": "Loopback listener",
      "kind": "endpoint",
      "details": {
        "binds": "127.0.0.1 on port 8792 unless installed otherwise",
        "serves": "/healthz, /control/drain, /control/handoff and /<provider>/v1/responses and models",
        "starts": "only from a payload whose digests it has verified"
      },
      "files": [
        "src/openai_responses_proxy/serving/server.py",
        "src/openai_responses_proxy/serving/"
      ]
    },
    {
      "id": "request-admission",
      "label": "Request admission",
      "kind": "gate",
      "details": {
        "reads": "one length-framed body within 30 s and 64 MiB",
        "drains": "Responses admission for a bounded lease",
        "controls": "drain and handoff only from a loopback client with a loopback Host and no Origin"
      },
      "files": ["src/openai_responses_proxy/relay/admission.py"]
    },
    {
      "id": "responses-relay",
      "label": "Responses relay",
      "kind": "relay",
      "details": {
        "orders": "route, body, projection, delegation, cooldown, admission, exchange, delivery",
        "relays": "model catalog reads once, without Responses policy"
      },
      "files": [
        "src/openai_responses_proxy/relay/responses.py",
        "src/openai_responses_proxy/relay/"
      ]
    },
    {
      "id": "replay-projection",
      "label": "Replay projection",
      "kind": "grammar",
      "details": {
        "sends": "store=false, without response, conversation or cache bindings",
        "keeps": "portable dialogue and complete tool call and output pairs",
        "refuses": "unknown or unsafe structure before any upstream I/O"
      },
      "files": [
        "src/openai_responses_proxy/protocol/replay/projection.py",
        "src/openai_responses_proxy/protocol/replay/",
        "src/openai_responses_proxy/protocol/__init__.py"
      ]
    },
    {
      "id": "agent-delivery",
      "label": "Agent delivery",
      "kind": "grammar",
      "details": {
        "aliases": "collaboration as collaboration_plaintext on a plaintext route",
        "restores": "the native namespace once readable arguments arrive"
      },
      "files": ["src/openai_responses_proxy/protocol/agent_delivery.py"]
    },
    {
      "id": "bounded-recovery",
      "label": "Bounded recovery",
      "kind": "grammar",
      "details": {
        "derives": "strictly smaller, pair-safe requests from the projected one",
        "keeps": "the latest user turn and the current-turn controls",
        "recognizes": "exact input-length and media-budget refusals, which get one smaller retry"
      },
      "files": [
        "src/openai_responses_proxy/protocol/recovery/execution.py",
        "src/openai_responses_proxy/protocol/recovery/"
      ]
    },
    {
      "id": "upstream-exchange",
      "label": "Upstream exchange",
      "kind": "relay",
      "details": {
        "retries": "only what the failure class allows, within one total deadline",
        "cools": "one provider after a 429 or an exhausted 503"
      },
      "files": [
        "src/openai_responses_proxy/relay/exchange.py",
        "src/openai_responses_proxy/relay/cooldown.py",
        "src/openai_responses_proxy/relay/wire_recovery.py"
      ]
    },
    {
      "id": "upstream-transport",
      "label": "Upstream transport",
      "kind": "transport",
      "details": {
        "bounds": "DNS, connection, TLS, writes and reads by the exchange deadline",
        "reuses": "an idle keep-alive connection at most 30 s old",
        "refuses": "redirects; a complete request is never sent twice"
      },
      "files": [
        "src/openai_responses_proxy/relay/upstream.py",
