  "views": [
    {
      "id": "request-path",
      "title": "One Responses turn, from the client to a provider",
      "question": "Which parts does one Responses turn cross between the client and its provider?",
      "summary": "The loopback listener passes each turn to the Responses relay, which projects the body and admits it. The upstream exchange sends it over the upstream transport to the provider; response delivery returns JSON or SSE.",
      "members": [
        "client",
        "listener",
        "request-admission",
        "responses-relay",
        "replay-projection",
        "upstream-exchange",
        "upstream-transport",
        "response-delivery",
        "provider"
      ]
    },
    {
      "id": "portability",
      "title": "What leaves the listener",
      "question": "How does a request become portable across providers, and how is a refused one made smaller?",
      "summary": "Replay projection sends store=false and no response, conversation or cache bindings, keeping calls paired with outputs. Bounded recovery re-projects strictly smaller, pair-safe requests derived from a refused one.",
      "members": [
        "responses-relay",
        "replay-projection",
        "agent-delivery",
        "bounded-recovery",
        "upstream-exchange",
        "response-delivery",
        "provider-registry"
      ]
    },
    {
      "id": "failures",
      "title": "Failures bounded per provider",
      "question": "How are upstream failures retried, cooled and reported without holding up another provider?",
      "summary": "The upstream exchange retries only what the failure class allows and cools only its provider after a 429 or an exhausted 503. Telemetry counts failure classes; the transport never sends a complete request twice.",
      "members": [
        "upstream-exchange",
        "upstream-transport",
        "bounded-recovery",
        "provider-registry",
        "response-delivery",
        "telemetry",
        "provider"
      ]
    },
    {
      "id": "install",
      "title": "One install, one transaction",
      "question": "How does a signed release asset become the selected generation, and what can be rolled back?",
      "summary": "Release admission verifies SHA256SUMS.sig, and a journaled payload transaction materializes the admitted bytes as a new generation. It ends finalized or rolled back; the selector keeps at most one predecessor.",
      "members": [
        "command-line",
        "lifecycle-commands",
        "release-admission",
        "payload-transaction",
        "owned-files",
        "generation-selector",
        "deployment",
        "runtime-settings"
      ]
    },
    {
      "id": "handoff",
      "title": "A new listener without a dropped turn",
      "question": "How do an upgrade and a reload move the listening socket to a new process?",
      "summary": "Listener handoff passes the listening socket to a successor process while admission stays open; deployment drains and replaces an older runtime. It proves the successor's identity before the transaction finalizes.",
      "members": [
        "deployment",
        "listener",
        "listener-handoff",
        "runtime-identity",
        "request-admission",
        "native-supervision",
        "generation-selector"
      ]
    },
    {
      "id": "supervision",
      "title": "Kept running by the operating system",
      "question": "Who starts the listener and keeps it running?",
      "summary": "The lifecycle commands register native supervision and remove it on uninstall; it registers the watchdog, which the native service manager starts and restarts. The watchdog starts the listener on a closed port, but waits while a transaction is open and not yet activated.",
      "members": [
        "lifecycle-commands",
        "native-supervision",
