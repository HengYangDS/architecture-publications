  "views": [
    {
      "id": "overview",
      "title": "一次构建的全程",
      "question": "从作者的模型到出版的交付物，一次构建要经过哪些部分？",
      "summary": "作者运行 archpub build，由交付物构建器生成图版、图册和页面，以及数据和读者文件。审阅者运行 compare、accept 和 verify；“验收与出版”在交付物旁排出验收页，只把已验收的交付物复制到出版根目录。",
      "tiers": [
        {
          "id": "people",
          "label": "角色",
          "members": ["author", "reviewer"]
        },
        {
          "id": "commands",
          "label": "命令行",
          "members": ["cli"]
        },
        {
          "id": "stages",
          "label": "阶段",
          "members": ["builder", "acceptance"]
        },
        {
          "id": "media",
          "label": "媒介",
          "members": ["plates", "edition", "map", "data"]
        },
        {
          "id": "outside",
          "label": "软件包之外",
          "members": ["publication-root"]
        }
      ]
    },
    {
      "id": "files",
      "title": "文件：取自固定的提交",
      "question": "构建怎样把每个文件交给认领它的组件？archpub check 又报告些什么？",
      "summary": "在固定的提交上，“文件绑定”按最具体的认领规则，把范围内的每个文件交给所属组件，并读出它的哈希摘要、大小和最近一次改动；“测得的事实”据此给出每个组件的大小和每个文件的新旧分档，数据为每个路径留一行证据。“覆盖报告”统计已归属、未覆盖和已排除的文件；“更换提交的待办清单”列出更换固定的提交带来的变化。",
      "members": [
        "builder",
        "model",
        "binding",
        "facts",
        "data",
        "scope",
        "coverage",
        "worklist",
        "repository"
      ]
    },
    {
      "id": "models",
      "title": "模型从何而来",
      "question": "哪些组件从 LikeC4 或旧版模型引入模型？所有模型又由谁校验？",
      "summary": "模型可以由作者手写，也可以经 archpub 得到：LikeC4 导入器解析 LikeC4 工作空间，“模型迁移”把第 1、2 版模型转成第 3 版。模型加载器一律按第 3 版校验。",
      "members": ["author", "cli", "importer", "migration", "model", "words", "supplies"]
    },
    {
      "id": "layout",
      "title": "网格布局",
      "question": "同一套网格怎样既排图版，又排页面里的图？",
      "summary": "行由层级或关系决定。“摆放”精确求出卡片位置，“连线”把关系归并成总线和走廊，通道求解器为每条通道布线；整洁度量不容许任何重叠。",
      "tiers": [
        {
          "id": "media",
          "label": "媒介",
          "members": ["plates", "map"]
        },
        {
          "id": "grid",
          "label": "网格",
          "members": ["layout"]
        },
        {
          "id": "parts",
          "label": "机制",
          "members": ["rows", "placement", "wires", "solver", "measure"]
        }
      ]
    },
    {
      "id": "edition",
      "title": "图册",
      "question": "规划好的视图由谁排成图册？这一步用到哪些物料？",
      "summary": "图版编排器把每个规划好的视图排成一幅图版，每个组件画成一张卡片，卡片上条带的长度与名下文件的大小成正比。“图册”用 Typst 一遍排出全部图版和总览，总览按模型写明的内容画出；字体和图标都由“物料”提供。",
      "members": [
        "builder",
        "plan",
        "plates",
        "typefaces",
        "presentation",
        "words",
        "edition",
        "overview",
        "typst",
        "supplies"
      ]
    },
    {
      "id": "page",
      "title": "页面",
      "question": "页面怎样生成？生成时检查什么？",
      "summary": "组件“讲解页”调用 Archify 生成页面，每个视图一个面板；模型指定了导读时，交付的就是作者写的导读。组件“导读”按固定的提交克隆仓库，逐一核验导读引用的每个行区间。",
      "members": ["builder", "map", "guide", "presentation", "words", "supplies", "repository"]
    }
  ],
