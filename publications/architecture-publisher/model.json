{
  "format": "architecture-publisher.model",
  "version": 1,
  "id": "architecture-publisher",
  "title": "Architecture Publisher",
  "question": "How does Architecture Publisher turn an architecture model into posters, a page and an overview?",
  "summary": "An editor runs archpub on a model or a LikeC4 workspace. One build validates the model, verifies its sources, plans its views, lays each out on one grid and writes 16:9 poster pages, a native Archify explainer page, the overview its author composes in Typst and a manifest of their digests and evidence; archpub check also counts what the model covers of its repository.",
  "attribution": "Architecture Publications, read from the Architecture Publisher source",
  "scope": "The publisher package and its vendored supplies; not the repository's quality tooling or CI",
  "limits": [
    "Curated from the selected modules at the pinned revision; relations describe calls between those modules, not every function"
  ],
