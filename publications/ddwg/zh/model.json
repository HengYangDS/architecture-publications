{
  "format": "architecture-publisher.model",
  "version": 3,
  "id": "ddwg",
  "locale": "zh-CN",
  "title": "数据部门工作指南",
  "question": "怎样把读者引到某项工作适用的规则？指南要改，又怎样提出、检查和发布？",
  "summary": "一张任务地图把每个工作问题引到八个主题之一，章程居首。指南及其维护须满足的要求，写在六份 OpenSpec 能力规格里。每项改动都要由已安装的 ETHOS 准入和核验，已签名的版本再分别发到各个代码托管平台。",
  "scope": "v10.1.3 发布时的指南：各个入口、任务地图、八个主题、决策记录、维护文档、OpenSpec 工作空间和其中的六份能力规格，以及维护这一切的 ETHOS 配置、工具配置、检查配置和 CI 配置。",
  "limits": [
    "组件只列出它认领的路径下的文件，关系只列出两类文件：一类生成、安装或运行对方组件，另一类用链接、写明的路径或需求把读者引到对方、把职责交给对方或约束对方。",
    "八个主题之间只画指向章程的链接；指回入口、任务地图或“仓库变更与发布”的链接，以及别的文档已经给出的指引，都不画。",
    "已归档的正式变更历史不在范围内。这里讲文档和检查本身，不讲部门实际用得怎样。"
  ],
  "repository": {
    "name": "data-department-work-guidelines",
    "url": "https://github.com/HengYangDS/data-department-work-guidelines.git",
    "revision": "127e15186115c1cf30e9f476e4991d587bf50500"
  },
  "coverage": {
    "exclude": [
      {
        "path": "openspec/changes/archive/",
        "reason": "已完成的正式变更作为历史保留；仓库把它们当作历史输入，不当作现行规则或核验结果。"
      }
    ]
  },
  "overview": {
    "claim": "从工作问题到规则所在的那一个主题",
    "lead": "成员和智能体不用安装任何软件就能读这份指南；维护者修改指南，要走一项 OpenSpec 正式变更，由已安装的 ETHOS 准入、核验并发布。",
    "course": {
      "steps": [
        {
          "id": "entries",
          "label": "两个入口，一张任务地图",
          "note": "成员和智能体读同一套指南",
          "stations": [
            {
              "branches": [
                {
                  "part": "repository-entry",
                  "note": "README.md：先讲宗旨，再引向任务地图，并写明 MIT License 授权"
                },
                {
                  "part": "agent-entry",
                  "note": "AGENTS.md：委托范围；授权和验收留在人手里"
                }
              ]
            },
            {
              "part": "task-map",
              "note": "docs/README.md，紧急路线在前"
            }
          ],
          "view": "readers"
        },
        {
          "id": "topics",
          "label": "八个主题，每条规则只归一处",
          "note": "任务地图把每个工作问题引到负责它的主题",
          "stations": [
            {
              "branches": [
                {
                  "part": "charter",
                  "note": "两种依据、四条底线，以及四个主题引用的风险分级"
                },
                {
                  "part": "decide",
                  "note": "界定决策问题、诊断故障、让方案可以比较"
                },
                {
                  "part": "data",
                  "note": "证明数据资产适合用途；变更共享或生产数据"
                },
                {
                  "part": "deliver",
                  "note": "动手前核对承诺；凭证据收尾"
                },
                {
                  "part": "communicate",
                  "note": "理清汇报、决策文档或上报的结构"
                },
                {
                  "part": "human-agent",
                  "note": "委托有边界的任务；检查智能体的实际输出"
                },
                {
                  "part": "evolve",
                  "note": "紧急情况与例外；辅导；一项实践的准入或废止"
                },
                {
                  "part": "grow",
                  "note": "职级、绩效档位与晋升，都凭工作记录评定"
                }
              ]
            }
          ],
          "view": "overview"
        }
      ]
    },
    "blocks": [
      {
        "title": "一条规则，只归一处",
        "text": "每条规则只在一处维护。导航、范例、决策记录和治理页面都链接过去，不另写一遍。"
      },
      {
        "title": "紧急优先",
        "text": "处理紧急故障或越界事件的路线，排在所有常规路线之前。",
        "view": "readers"
      },
      {
        "title": "四条底线",
        "items": [
          ["说真话", "不编造、不隐瞒、不挑着说；没把握的不说成有把握"],
          ["守边界", "对象、时间、能力、权限、数据、安全、合规、行动"],
          ["责任落到人", "每项判断、决定、变更和验收都有人负责"],
          ["不虚报完成", "没有对得上的证据，不说完成、正确、可用或已采用"]
        ],
        "view": "practice"
      },
      {
        "title": "形式随风险而定",
        "items": [
          ["L0 低风险", "局部、可逆：一次讲清结论、依据和做法"],
          ["L1 标准", "跨角色、方案相互竞争或存在重大不确定性：留一份可评审的记录"],
          ["L2 高风险", "生产环境、资金、敏感数据、覆盖写入：授权、回滚、评审"],
          ["评审", "看实际的事实和证据，不看作者或智能体自己怎么说"]
        ],
        "view": "practice"
      },
      {
        "title": "每项改动都走一项正式变更",
        "stations": [
          {
            "id": "change",
            "label": "正式变更",
            "note": "提案、设计、规格增量、tasks.md"
          },
          {
            "id": "lane",
            "label": "工作通道",
            "note": "归属与租约由 ETHOS 管理"
          },
          {
            "id": "prewrite",
            "label": "写前准入",
            "note": "具体到路径，写入前一刻"
          },
          {
            "id": "commit",
            "label": "提交",
            "note": "可信的 SSH 签名"
          },
          {
            "id": "proof",
            "label": "核验"
          },
          {
            "id": "accepted",
            "label": "已验收",
            "note": "dev 快进前移"
          },
          {
            "id": "archive",
            "label": "归档",
            "note": "新的提交，重新核验"
          }
        ],
        "pass": {
          "after": "proof",
          "label": "通过"
        },
        "aside": {
          "from": "proof",
          "label": "阻断或未知：分支不前移，也不能用直接推送绕过核验"
        },
        "text": "核验就是在主机上对 HEAD 所指的那一个提交运行全套检查。",
        "view": "change"
      },
      {
        "title": "谁负责什么",
        "items": [
          ["OpenSpec 正式变更", "实质改动的意图、需求、设计，以及 tasks.md 里的进度"],
          ["已安装的 ETHOS", "改动归属、租约、准入、核验、验收和发布"],
          ["仓库变更与发布", "权限、验收、发布和撤下的边界"],
          ["贡献指南", "编辑、核验、安装 ETHOS、发布各用的具体命令"],
          ["配置地图", "每项检查背后的原生配置"],
          ["决策记录", "长期决策的理由和被否决的备选方案，不记任务或日志"]
        ]
      },
      {
        "title": "版本",
        "items": [
          ["VERSION", "10.1.3，唯一的发布标识；变更日志跟着它走"],
          ["标签", "已签名的 vX.Y.Z，与 VERSION 和对应的变更日志条目一致"]
        ],
        "view": "release"
      },
      {
        "title": "两个平台，各自独立",
        "items": [
          ["GitLab", "本组织的发布平台"],
          ["GitHub", "独立的仓库、CI/CD 和分发"]
        ],
        "view": "release"
      },
      {
        "title": "通过了也说明不了的事",
        "items": [
          ["检查", "含义、阅读顺序或团队采用"],
          ["本地核验", "已交付到任一平台"]
        ],
        "view": "checks"
      }
    ]
  },
