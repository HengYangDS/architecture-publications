  "views": [
    {
      "id": "overview",
      "title": "八个主题，章程居首",
      "question": "任务地图把哪类工作问题引到哪个主题？",
      "summary": "任务地图把每个工作问题引到负责它的主题，处理紧急故障或越界事件的路线排在最前。依据和风险方面的问题引到章程，有四个主题引用它的风险分级。",
      "members": [
        "agent-entry",
        "task-map",
        "charter",
        "decide",
        "deliver",
        "data",
        "communicate",
        "human-agent",
        "evolve",
        "grow"
      ]
    },
    {
      "id": "readers",
      "title": "读者从哪里读起",
      "question": "每个入口把成员、智能体和维护者引向哪里？",
      "summary": "成员先读仓库入口，由它进入任务地图，维护者则被引到贡献指南。智能体从智能体入口读起，再到任务地图；要改动仓库，先读“仓库变更与发布”。",
      "members": [
        "members",
        "repository-entry",
        "agent-entry",
        "task-map",
        "governance",
        "decision-records",
        "contributing",
        "spec-guidance-discovery"
      ]
    },
    {
      "id": "practice",
      "title": "“工作实践”对各主题的要求",
      "question": "哪项职责落在哪个主题？各主题共用哪些规则？",
      "summary": "“工作实践”给章程之下的七个主题规定职责，比如要求“分析与决策”主题界定问题、留下记录。其中四个主题共用章程的风险分级；“实践与演进”和“职级、绩效档位与成长”引用它的底线。",
      "members": [
        "spec-work-practice",
        "decision-records",
        "charter",
        "decide",
        "deliver",
        "data",
        "communicate",
        "human-agent",
        "evolve",
        "grow"
      ]
    },
    {
      "id": "change",
      "title": "一项改动的提出与准入",
      "question": "一项改动记在哪里？由谁准入？",
      "summary": "OpenSpec 工作空间为每项实质改动存放一项对应的正式变更，由 ETHOS 校验和规划。ETHOS 治理配置把任何路径的改动都算作实质改动，并把仓库绑定到已安装的 ETHOS，由后者负责准入。",
      "members": [
        "governance",
        "contributing",
        "configuration-map",
        "decision-records",
        "openspec-workspace",
        "ethos-profile",
        "ethos",
        "spec-repository-governance",
        "spec-verification"
      ]
    },
    {
      "id": "checks",
      "title": "各项检查读什么",
      "question": "每项检查的原生配置放在哪里？CI 里又由什么运行这些检查？",
      "summary": "配置地图指出每项检查读取的原生配置：ETHOS 的各项检查按“检查配置”运行，ETHOS 本身由“工具安装”负责安装。在 CI 里，由 CI 参数生成流水线，流水线安装锁定版本的 ETHOS，再运行全套检查。",
      "members": [
        "configuration-map",
        "check-inputs",
        "tool-supply",
        "ci-parameters",
        "pipelines",
        "ethos",
        "spec-quality",
        "spec-verification",
        "contributing"
      ]
    },
    {
      "id": "release",
      "title": "一个版本，两个平台",
      "question": "一个版本怎样定版，又怎样发布到 GitLab 和 GitHub？",
      "summary": "维护者按贡献指南准备版本、定版，再在每个平台创建发行版。“发布配置”绑定 GitLab 和 GitHub 两个平台以及受保护的 v* 标签；已签名的版本分别发到每个平台。",
      "members": [
        "governance",
        "contributing",
        "edition",
        "release-declaration",
        "pipelines",
        "forges",
        "spec-publication",
        "spec-repository-governance"
      ]
    }
