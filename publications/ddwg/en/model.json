{
  "format": "architecture-publisher.model",
  "version": 3,
  "id": "ddwg",
  "locale": "en",
  "title": "Data Department Work Guidelines",
  "question": "How do the Data Department work guidelines lead a reader to the rule that governs a task, and how is a change to them proposed, checked and released?",
  "summary": "One task map routes each work question to one of eight topics led by the charter. Six OpenSpec capability specs state what the guidance and its upkeep must do, installed ETHOS admits and proves every change, and each Forge receives the signed release independently.",
  "scope": "The guidelines as released at v10.1.3: the entries, the task map, the eight topics, the decision records, the maintenance documents, the OpenSpec workspace with its six capability specs, and the configuration of ETHOS, tools, checks and CI that maintains them.",
  "limits": [
    "A component lists only the files under the paths it claims, and a relation only those that generate, install or run the other component, or whose link, named path or requirement routes a reader to it, places a duty on it or constrains it.",
    "Between the eight topics, only links to the charter are drawn. Links back to an entry, the task map or Repository change and release, and pointers that another document already holds, are not.",
    "The archived Change history is outside the scope; documents and checks are described, not their observed use by the department."
  ],
  "repository": {
    "name": "data-department-work-guidelines",
    "url": "https://github.com/HengYangDS/data-department-work-guidelines.git",
    "revision": "127e15186115c1cf30e9f476e4991d587bf50500"
  },
  "coverage": {
    "exclude": [
      {
        "path": "openspec/changes/archive/",
        "reason": "Completed Changes are kept as history; the repository treats them as historical inputs, not current rules or proof."
      }
    ]
  },
  "overview": {
    "claim": "From a work question to the one topic that owns its rule",
    "lead": "Members and Agents read these guidelines without installing anything; maintainers change them through one official OpenSpec Change, which installed ETHOS admits, proves and publishes.",
    "course": {
      "steps": [
        {
          "id": "entries",
          "label": "Two entries, one task map",
          "note": "members and Agents read the same guidance",
          "stations": [
            {
              "branches": [
                {
                  "part": "repository-entry",
                  "note": "README.md: the purpose, then the task map and the MIT License"
                },
                {
                  "part": "agent-entry",
                  "note": "AGENTS.md: a delegated scope; people keep authorization and acceptance"
                }
              ]
            },
            {
              "part": "task-map",
              "note": "docs/README.md, urgent route first"
            }
          ],
          "view": "readers"
        },
        {
          "id": "topics",
          "label": "Eight topics, one owner for each rule",
          "note": "the task map routes each work question to the topic that owns it",
          "stations": [
            {
              "branches": [
                {
                  "part": "charter",
                  "note": "two kinds of authority, four non-negotiable boundaries, the risk levels four topics cite"
                },
                {
                  "part": "decide",
                  "note": "frame a decision, diagnose a failure, make options comparable"
                },
                {
                  "part": "data",
                  "note": "qualify a data asset; change shared or production data"
                },
                {
                  "part": "deliver",
                  "note": "check the commitment before acting; close the work on evidence"
                },
                {
                  "part": "communicate",
                  "note": "structure an update, a decision document or an escalation"
                },
                {
                  "part": "human-agent",
                  "note": "delegate a bounded task; check the Agent's actual output"
                },
                {
                  "part": "evolve",
                  "note": "emergencies and exceptions; coaching; admitting or retiring a practice"
                },
                {
                  "part": "grow",
                  "note": "grades, tiers and promotion, judged from work records"
                }
              ]
            }
          ],
          "view": "overview"
        }
      ]
    },
    "blocks": [
      {
        "title": "One owner for each rule",
        "text": "Each rule has one editable owner. Navigation, examples, decision records and governance link to it without restating it."
      },
      {
        "title": "Urgent first",
        "text": "The route for an urgent failure or breach comes before every routine route.",
        "view": "readers"
      },
      {
        "title": "Four non-negotiable boundaries",
        "items": [
          [
            "Tell the truth",
            "no fabricated, hidden or selectively presented facts; no uncertainty dressed as certainty"
          ],
          [
            "Stay in bounds",
            "subject, time, competence, permission, data, security, compliance, action"
          ],
          [
            "Name the owner",
            "an accountable person for each judgment, decision, change and acceptance"
          ],
          [
            "No false completion",
            "nothing claimed complete, correct, usable or adopted without matching evidence"
          ]
        ],
        "view": "practice"
      },
      {
        "title": "Form follows risk",
        "items": [
          ["L0 low risk", "local and reversible: conclusion, basis and action in one exchange"],
          [
            "L1 standard",
            "cross-role work, competing options or material uncertainty: a reviewable record"
          ],
          [
            "L2 high risk",
            "production, funds, sensitive data, overwrite: authorization, rollback, review"
          ],
          [
            "Review",
            "examines the actual facts and evidence, not the author's or the Agent's account"
          ]
        ],
        "view": "practice"
      },
      {
        "title": "Every change is one official Change",
        "stations": [
          {
            "id": "change",
            "label": "Change",
            "note": "proposal, design, deltas, tasks.md"
          },
          {
            "id": "lane",
            "label": "Lane",
            "note": "owned and leased by ETHOS"
          },
          {
            "id": "prewrite",
            "label": "Prewrite",
            "note": "exact paths, just before writing"
          },
          {
            "id": "commit",
            "label": "Commit",
            "note": "a trusted SSH signature"
          },
          {
            "id": "proof",
            "label": "Proof"
          },
          {
            "id": "accepted",
            "label": "Accepted",
            "note": "dev advances by fast-forward"
          },
          {
            "id": "archive",
            "label": "Archive",
            "note": "a new commit, proved again"
          }
        ],
        "pass": {
          "after": "proof",
          "label": "pass"
        },
        "aside": {
          "from": "proof",
          "label": "block or unknown: nothing moves, and no raw push goes around it"
        },
        "text": "Proof: the full graph on the host at the exact HEAD.",
        "view": "change"
      },
      {
        "title": "Who owns what",
        "items": [
          ["OpenSpec Change", "material intent, requirements, design and progress in tasks.md"],
          ["Installed ETHOS", "attribution, lease, admission, proof, acceptance and publication"],
          [
            "Repository change and release",
            "permission, acceptance, release and retirement boundaries"
          ],
          ["Contributing", "the exact commands to edit, verify, install ETHOS and publish"],
          ["Configuration map", "the native input behind each check"],
          ["Decision records", "durable rationale and rejected alternatives, never tasks or logs"]
        ]
      },
      {
        "title": "The release",
        "items": [
          ["VERSION", "10.1.3, the one release identity; the Changelog follows it"],
          ["Tag", "a signed vX.Y.Z that matches VERSION and its Changelog entry"]
        ],
        "view": "release"
      },
      {
        "title": "Two Forges, each independent",
        "items": [
          ["GitLab", "the organization's publication plane"],
          ["GitHub", "an independent repository, CI/CD and distribution"]
        ],
        "view": "release"
      },
      {
        "title": "What a pass does not prove",
        "items": [
          ["Checks", "meaning, reading order or team adoption"],
          ["Local proof", "delivery to either Forge"]
        ],
        "view": "checks"
      }
    ]
  },
