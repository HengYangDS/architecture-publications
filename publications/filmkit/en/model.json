      "id": "thought-takes",
      "label": "Thought takes",
      "kind": "narration",
      "details": {
        "narrates": "each thought natively with the pinned voice model, from the cast's seed or retake",
        "derives": "each thought's spoken text through the film's pronunciation contract",
        "reuses": "a take whose request fingerprint and recording still match",
        "judges": "whether a take ends naturally"
      },
      "files": [
        "src/filmkit/narration/pronunciation.py",
