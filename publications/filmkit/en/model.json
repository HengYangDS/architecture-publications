      "details": {
        "concepts": "each segment says its declared concepts in approved words, and no counterexample appears",
        "readings": "each watched Chinese character has a declared reading, and each name a spoken form",
        "terms": "each declared Latin-script term is spelled alike for the narrator and said like the occurrence a person heard correct"
      },
      "files": [
        "src/filmkit/concepts.py",
        "src/filmkit/narration/readings.py",
        "src/filmkit/narration/watched-characters.toml",
