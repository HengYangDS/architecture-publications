    },
    {
      "id": "auditions",
      "label": "Auditions and script edits",
      "kind": "narration",
      "details": {
        "auditions": "other seeds of a thought, and proposes a take that ends naturally",
        "binds": "the chosen seed to the thought's exact text and speech",
        "edits": "thoughts in place, moving each retake with its text"
      },
      "files": ["src/filmkit/narration/audition.py", "src/filmkit/narration/script_edits.py"]
    },
    {
      "id": "alignment",
      "label": "Alignment and selection",
      "kind": "narration",
      "details": {
        "aligns": "each recording to its exact text with the pinned forced aligner",
        "transcribes": "each recording as a recognition proxy, not certification",
        "selects": "the recordings and alignment bound to the current script and cast, within the film's pause limits and declared terms"
      },
      "files": [
        "src/filmkit/narration/alignment.py",
        "src/filmkit/narration/alignment_records.py",
        "src/filmkit/narration/transcription.py",
