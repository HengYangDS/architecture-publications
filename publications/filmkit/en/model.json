    {
      "id": "supply",
      "label": "Supply",
      "kind": "adapter",
      "details": {
        "installs": "the pinned browser build and three speech models, each checked against its digests",
        "network": "the only step that reaches it"
      },
      "files": ["src/filmkit/supply.py", "src/filmkit/narration/snapshots.py"]
    },
    {
      "id": "spoken-units",
      "label": "Spoken units",
      "kind": "contract",
      "details": {
        "names": "the spoken units, punctuation roles, joins and thought spans that sound, captions and audits share",
        "measures": "the heard pause at each word boundary, which selection and assembly limit, and the steps between thoughts, for listening"
      },
      "files": ["src/filmkit/narration/spoken_units.py", "src/filmkit/narration/flow.py"]
    },
    {
      "id": "soundtrack",
      "label": "Soundtrack assembly",
      "kind": "step",
      "details": {
        "assembles": "the selected takes with designed pauses at one program level",
        "refuses": "a take that ends abruptly without a declared release, an unmarked pause above its limit, and a declared term said unlike its reference",
        "writes": "the soundtrack, the timeline and the assembly receipt"
      },
      "files": ["src/filmkit/soundtrack/"]
    },
    {
      "id": "captions",
      "label": "Captions",
      "kind": "step",
      "details": {
        "times": "one-line cues on the exact aligned words, never across a thought",
        "writes": "SRT, VTT, the transcript, the chapters and their metadata"
      },
      "files": ["src/filmkit/captions/"]
    },
    {
