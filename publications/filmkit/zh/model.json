  "views": [
    {
      "id": "overview",
      "title": "从影片源文件到交付成片",
      "question": "一个语言版从脚本到四部交付成片，要靠哪些命令？",
      "summary": "旁白命令为“意群录音”运行语音合成。制作命令拼接音轨、刷新字幕、检查画面，门禁记录通过后才渲染画面，最后打包出四部成片。两条命令结束时都写一份耗时记录。",
      "members": [
        "narration-command",
        "thought-takes",
        "production-command",
        "soundtrack",
        "captions",
        "picture-gate",
        "picture-rendering",
        "packaging",
        "duration-records"
      ]
    },
    {
      "id": "film",
      "title": "引擎从影片读取什么",
      "question": "引擎要从正在构建的影片里读取什么？朗读之前哪些条件必须成立？",
      "summary": "“影片与语言版”读取影片仓库里的声明，开工前先检查一遍。旁白命令先做字词检查，查概念、读音和术语；不合格的，在任何语音模型加载之前就拒绝。",
      "members": [
        "film-repository",
        "film-and-editions",
        "production-command",
        "narration-command",
        "word-checks",
        "thought-takes",
        "picture-rendering",
        "picture-audits"
      ]
    },
    {
      "id": "narration",
      "title": "旁白与下载安装",
      "question": "每个意群怎样朗读、试音和对齐？下载安装这一步先装好什么？",
      "summary": "“意群录音”按配音设定里的种子或重录朗读每个意群，试音则换其他种子再读；“对齐与选定”把每份录音对齐到它的文本。“下载安装”负责装好指定构建版本的浏览器和三个语音模型。旁白命令被要求结束时，旁白的各个进程也随之结束。",
      "members": [
        "narration-command",
        "thought-takes",
        "alignment",
        "auditions",
        "child-processes",
        "supply",
        "speech-models",
        "renderer"
      ]
    },
    {
      "id": "sound",
      "title": "声音与字幕出自同一次拼接",
      "question": "选定的录音怎样变成一条音轨、一份时间线和上面的字幕？",
      "summary": "“音轨拼接”把选定的录音配上设计好的停顿，按统一的节目响度写出音轨和时间线，收尾突兀的录音一律拒绝。“字幕”按对齐好的词打时间轴，一条字幕绝不跨两个意群。",
      "members": [
        "production-command",
        "alignment",
        "thought-takes",
        "soundtrack",
        "captions",
        "spoken-units",
        "media-probe",
        "host-tools"
      ]
    },
    {
      "id": "picture",
      "title": "画面的门禁与渲染",
      "question": "渲染之前，画面靠什么检测？又靠什么渲染？",
      "summary": "“画面门禁”交给 Node 工具运行器做逐帧、动效和细节检测，并在门禁记录里绑定画面合成、字体和引擎版本。门禁记录通过后，“画面渲染”才交给 HyperFrames。",
      "members": [
        "picture-gate",
        "tool-runner",
        "picture-audits",
        "browser-checks",
        "picture-rendering",
        "renderer",
        "engine-package",
        "media-probe",
        "host-tools"
      ]
    },
    {
      "id": "acceptance",
      "title": "打包、核验、交付与评审",
      "question": "成片怎样打包、核验、交付、评审和复现？",
      "summary": "“打包”编码出四部成片；“核验”读取并解码；“交付”送出 25 个交付项并逐一读回。“评审”为独立评审人准备提示词；“复现”把重建结果与已发布版本比对。",
      "members": [
        "packaging",
        "verification",
        "reproduction",
        "delivery",
        "review",
        "reviewer",
        "media-probe",
        "host-tools"
      ]
    }
