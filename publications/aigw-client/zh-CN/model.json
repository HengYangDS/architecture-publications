{
  "format": "architecture-publisher.model",
  "version": 3,
  "id": "aigw-client",
  "locale": "zh-CN",
  "title": "AIGW 统一客户端配置",
  "question": "AIGW 怎样把一份审阅过的配置，受保护地写入每个已准入客户端的原生配置？",
  "summary": "AIGW 把账户、路由和客户端绑定放在一份加锁的配置里，令牌放在选定的一个存储里。写入客户端时，它走统一的适配器接口，只改写每个客户端配置中归自己管的那一块；整个写入是一次受保护的事务，中途出错会补偿。请求绝不经过 AIGW。",
  "scope": "v0.6.1 发布版本的 AIGW 程序：生产代码的 Go 包、命令入口、团队清单和 go.mod。",
  "limits": [
    "每个组件都列出规则划给它的全部生产代码文件；每条关系列出的，是导入另一方组件的那些包里的文件。",
    "测试及其输入，以及仓库的工具、CI 和文档，都不在范围之内。"
  ],
  "repository": {
    "name": "aigw-cli",
    "url": "https://github.com/HengYangDS/aigw-cli.git",
    "revision": "abf05858f4092a3baf9acea0d5d7488b26898aa5",
    "browse": "https://github.com/HengYangDS/aigw-cli/blob/{revision}/{path}"
  },
  "coverage": {
    "include": ["cmd/", "internal/", "manifests/", "go.mod"],
    "exclude": [
      {
        "path": "**/*_test.go",
        "reason": "Go keeps each package's tests beside its code; they are not its architecture."
      },
      {
        "path": "cmd/aigw/testdata/",
        "reason": "Inputs of the command tests."
      }
    ]
  },
  "overview": "overview.typ",
  "guide": "guide/guide.archify.md",
  "kinds": {
    "interface": {
      "label": "接口",
      "category": "frontend",
      "icon": "square-terminal"
    },
    "coordinator": {
      "label": "协调者",
      "category": "backend",
      "icon": "workflow"
    },
    "observer": {
      "label": "观测者",
      "category": "cloud",
      "icon": "radar"
    },
    "registry": {
      "label": "注册表",
      "category": "messagebus",
      "icon": "list-ordered"
    },
    "contract": {
      "label": "契约",
      "category": "security",
      "icon": "file-cog"
    },
    "boundary": {
      "label": "边界",
      "category": "security",
      "icon": "shield-check"
    },
    "authority": {
      "label": "权威来源",
      "category": "database",
      "icon": "database"
    },
    "client": {
      "label": "客户端",
      "category": "external",
      "icon": "app-window"
    }
  },
  "components": [
    {
      "id": "program-entry",
      "label": "程序",
      "kind": "interface",
      "details": {
        "入口": "命令行程序"
      },
      "files": ["cmd/aigw/"]
    },
    {
      "id": "commands",
      "label": "命令",
      "kind": "interface",
      "details": {
        "包括": "setup、use、sync、check、verify、rotate、rollback、doctor、update 等",
        "结构": "每条命令一个包，只通过 invocation 共享行为"
      },
      "files": ["internal/cli/"]
    },
    {
      "id": "credential-helper",
      "label": "凭据助手",
      "kind": "interface",
      "details": {
        "命令": "aigw credential",
        "输出": "客户端需要时，把它自己的令牌写到标准输出；诊断信息绝不写到这里"
      },
      "files": ["internal/cli/credential/"]
    },
    {
      "id": "terminal",
      "label": "终端",
      "kind": "interface",
      "details": {
        "输出": "给人读的文字和 JSON、提示、错误；不导入任何用例"
      },
      "files": ["internal/terminal/"]
    },
    {
      "id": "use-cases",
      "label": "用例",
      "kind": "coordinator",
      "details": {
        "返回": "多条命令共用的值，交给终端渲染"
      },
      "files": ["internal/app/"]
    },
    {
      "id": "renaming",
      "label": "重命名",
      "kind": "coordinator",
      "details": {
        "职责": "分两个阶段迁移账户或路由的标识"
      },
      "files": ["internal/app/renaming/"]
    },
    {
      "id": "activation",
      "label": "激活",
      "kind": "coordinator",
      "details": {
        "范围": "判定一次操作涉及哪些已启用的客户端"
      },
      "files": ["internal/app/activation/"]
    },
    {
      "id": "synchronization",
      "label": "同步",
      "kind": "coordinator",
      "details": {
        "职责": "收敛客户端绑定和写入客户端的配置",
        "事务": "提交一次配置变更，出错时受保护地补偿"
      },
      "files": ["internal/app/synchronization/"]
    },
    {
      "id": "readiness",
      "label": "就绪状态",
      "kind": "coordinator",
      "details": {
        "状态": "已配置、端点已检查、推理已检查、已推迟、降级、无效、不可用"
      },
      "files": ["internal/app/readiness/"]
    },
    {
      "id": "diagnostics",
      "label": "诊断",
      "kind": "observer",
      "details": {
        "观测": "端点和认证的健康状况；探测有时限，结果会脱敏"
      },
      "files": ["internal/app/diagnostics/", "internal/provider/"]
    },
    {
      "id": "client-admission",
      "label": "客户端准入",
      "kind": "registry",
      "details": {
        "清单": "内置适配器，按准入顺序排列"
      },
      "files": ["internal/clients/"]
    },
    {
      "id": "adapter-seam",
      "label": "适配器接口",
      "kind": "contract",
      "details": {
        "操作": ["发现", "收敛", "规划", "应用", "检视", "验证", "撤回"],
        "测试": "每个适配器都要通过同一套契约测试"
      },
      "files": [
        "internal/adapter/registry.go",
        "internal/adapter/support.go",
        "internal/adapter/adapters.go",
        "internal/adapter/contract/",
        "internal/adapter/surface/",
        "internal/adapter/verification/"
      ]
    },
    {
      "id": "discovery",
      "label": "发现",
      "kind": "observer",
      "details": {
        "观测": "主机上的客户端和路径，只看不采纳"
      },
      "files": ["internal/adapter/discovery/"]
    },
    {
      "id": "codex",
      "label": "Codex",
      "kind": "client",
      "details": {
        "写入": "~/.codex/config.toml 中归 AIGW 管的一块，以及模型目录"
      },
      "files": ["internal/adapter/codex/"]
    },
    {
      "id": "claude-code",
      "label": "Claude Code",
      "kind": "client",
      "details": {
        "写入": "~/.claude/settings.json"
      },
      "files": ["internal/adapter/claude/"]
    },
    {
      "id": "claude-desktop",
      "label": "Claude Desktop",
      "kind": "client",
      "details": {
        "写入": "单独的第三方推理库"
      },
      "files": ["internal/adapter/claudedesktop/"]
    },
    {
      "id": "hermes",
      "label": "Hermes",
      "kind": "client",
      "details": {
        "写入": "提供商目录、协议和模型"
      },
      "files": ["internal/adapter/hermes/"]
    },
    {
      "id": "program-updates",
      "label": "程序更新",
      "kind": "boundary",
      "details": {
        "来源": "两个代码托管平台上已签名的发布版本",
        "安装": "验证过的便携程序，并保留前一版本"
      },
      "files": ["internal/program/"]
    },
    {
      "id": "credentials",
      "label": "凭据存储",
      "kind": "authority",
      "details": {
        "管理": "账户令牌，放在选定的一个后端，可以是原生密钥环、DPAPI 或属主专用文件"
      },
      "files": ["internal/secret/"]
    },
    {
      "id": "configuration-store",
      "label": "配置存储",
      "kind": "authority",
      "details": {
        "管理": "一把锁保护的 config.toml，以及它的检查点和模式迁移"
      },
      "files": ["internal/store/"]
    },
    {
      "id": "domain",
      "label": "领域",
      "kind": "authority",
      "details": {
        "管理": "账户、模型、路由、推荐、客户端绑定和团队清单",
        "依赖": "只用标准库"
      },
      "files": ["internal/domain/", "manifests/", "go.mod"]
    },
    {
      "id": "platform",
      "label": "平台",
      "kind": "boundary",
      "details": {
        "管理": "AIGW 自己的路径、受保护的文件写入和回滚、受限的子进程"
      },
      "files": ["internal/platform/"]
    }
  ],
