{
  "format": "architecture-publisher.model",
  "version": 3,
  "id": "aigw-client",
  "title": "AIGW Client Projection",
  "question": "How does AIGW turn one reviewed configuration into guarded native projections in every admitted client?",
  "summary": "AIGW keeps Accounts, Routes and Client Bindings in one locked configuration and its Tokens in one selected store, and projects each client's bounded region through one adapter seam as a guarded, compensated transaction. It never carries a request.",
  "scope": "The AIGW program as released at v0.6.1: its production Go packages, the command entry point, the team manifest and go.mod.",
  "limits": [
    "Each component cites every production file the rules attribute to it; a relation cites the files of the packages that import the other component.",
    "Tests, their inputs and the repository's tools, CI and documentation are outside the scope."
  ],
  "repository": {
    "name": "aigw-cli",
    "url": "https://github.com/HengYangDS/aigw-cli.git",
    "revision": "abf05858f4092a3baf9acea0d5d7488b26898aa5",
    "browse": "https://github.com/HengYangDS/aigw-cli/blob/{revision}/{path}"
  },
  "coverage": {
    "include": ["cmd/", "internal/", "manifests/", "go.mod"],
    "exclude": [
      {
        "path": "**/*_test.go",
        "reason": "Go keeps each package's tests beside its code; they are not its architecture."
      },
      {
        "path": "cmd/aigw/testdata/",
        "reason": "Inputs of the command tests."
      }
    ]
  },
  "overview": "overview.typ",
  "guide": "guide/guide.archify.md",
  "kinds": {
    "interface": {
