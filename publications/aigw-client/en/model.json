    },
    {
      "id": "commands",
      "label": "Commands",
      "kind": "interface",
      "details": {
        "commands": "setup, use, sync, check, status, provider, model, client, config, self and more",
        "shape": "one package per command, sharing behaviour only through invocation"
      },
      "files": ["internal/cli/"]
    },
    {
      "id": "credential-helper",
      "label": "Credential helper",
      "kind": "interface",
      "details": {
