    },
    {
      "id": "activation",
      "label": "Activation",
      "kind": "coordinator",
      "details": {
        "classifies": "the enabled-client scope of an operation"
      },
      "files": ["internal/app/activation/"]
    },
    {
      "id": "synchronization",
      "label": "Synchronization",
      "kind": "coordinator",
      "details": {
        "converges": "client selections and their client files",
        "commits": "one configuration transition with guarded compensation"
      },
      "files": ["internal/app/synchronization/"]
    },
    {
      "id": "readiness",
      "label": "Readiness",
      "kind": "coordinator",
      "details": {
        "states": "configured, deferred, degraded, invalid, unavailable",
        "depth": "the depth that aigw check reached says how much it proved"
      },
      "files": ["internal/app/readiness/"]
    },
    {
      "id": "diagnostics",
      "label": "Diagnostics",
      "kind": "observer",
      "details": {
        "observes": "bounded, redacted endpoint and authentication health",
        "balance": "a provider's optional balance, through bundled probes"
      },
      "files": ["internal/app/diagnostics/", "internal/balanceprobe/"]
    },
    {
      "id": "client-admission",
      "label": "Client admission",
      "kind": "registry",
