  "views": [
    {
      "id": "overview",
      "title": "One reviewed configuration, written into every client",
      "question": "How does one reviewed configuration become guarded client files in each admitted client?",
      "summary": "Synchronization persists to the configuration store and plans and applies through the adapter seam that each client adapter implements. It commits one configuration transition with guarded compensation.",
      "members": [
        "commands",
        "use-cases",
        "synchronization",
        "configuration-store",
        "adapter-seam",
        "codex",
        "claude-code",
        "claude-desktop",
        "hermes"
      ]
    },
    {
      "id": "authority",
      "title": "Who owns which state",
      "question": "Which owners hold the configuration, the Tokens and the host's paths, and who reads them?",
      "summary": "The configuration store owns aigw.toml under one lock and the credential store owns provider Tokens; the platform owns AIGW-owned paths. The credential helper reads one Token and the providers and clients it serves.",
      "members": [
        "commands",
        "credential-helper",
        "synchronization",
        "configuration-store",
        "credentials",
        "domain",
        "platform"
      ]
    },
    {
      "id": "adapters",
      "title": "Admitted clients and their seam",
      "question": "How are client adapters admitted, held to one contract and kept to guarded writes?",
      "summary": "The program admits clients: client admission lists the built-in adapters in admission order. Each adapter implements the adapter seam, held to one contract, and makes guarded writes through the platform.",
      "members": [
        "program-entry",
        "client-admission",
        "adapter-seam",
        "discovery",
        "codex",
        "claude-code",
        "claude-desktop",
        "hermes",
        "platform"
      ]
    },
    {
      "id": "readiness",
      "title": "What a command can report",
      "question": "How does a command decide what to report and what to do next?",
      "summary": "Activation classifies the enabled-client scope, and readiness reads health from diagnostics to give a state such as configured or degraded; the depth that aigw check reached says how much was proven. Use cases return values the terminal renders as human or JSON output.",
      "members": [
        "commands",
        "use-cases",
        "activation",
        "readiness",
        "diagnostics",
        "synchronization",
        "terminal",
        "domain"
      ]
    },
    {
      "id": "program",
      "title": "The program itself",
      "question": "How does the program start, admit its clients and replace itself?",
      "summary": "The program starts the commands and admits clients through client admission. Program updates resolves signed releases from both Forges and installs a portable program through the platform, keeping one predecessor.",
      "members": [
        "program-entry",
