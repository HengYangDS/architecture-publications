        "serves": "a client's own Token on demand, on standard output, where it never writes a diagnostic"
      },
      "files": ["internal/cli/credential/"]
    },
    {
      "id": "terminal",
      "label": "Terminal",
      "kind": "interface",
      "details": {
        "renders": "human and JSON output, prompts and errors; imports no use case"
      },
      "files": ["internal/terminal/"]
    },
    {
      "id": "use-cases",
      "label": "Use cases",
      "kind": "coordinator",
      "details": {
        "returns": "values that several commands share, for the terminal to render"
