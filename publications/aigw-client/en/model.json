    },
    {
      "id": "hermes",
      "label": "Hermes",
      "kind": "client",
      "details": {
        "writes": "its provider catalog, protocol and model"
      },
      "files": ["internal/adapter/hermes/"]
    },
    {
      "id": "program-updates",
      "label": "Program updates",
      "kind": "boundary",
      "details": {
        "resolves": "signed releases from both Forges",
        "installs": "a verified portable program, one predecessor kept"
      },
      "files": ["internal/program/"]
    },
    {
      "id": "credentials",
      "label": "Credential store",
      "kind": "authority",
      "details": {
        "owns": "provider Tokens in one selected backend: native keyring, DPAPI or an owner-only file"
      },
      "files": ["internal/secret/"]
    },
    {
      "id": "configuration-store",
      "label": "Configuration store",
      "kind": "authority",
      "details": {
        "owns": "aigw.toml under one lock, its backup and its verified snapshot",
        "reads, writes": "team files, the configuration's form without clients"
      },
      "files": ["internal/store/"]
    },
    {
      "id": "domain",
      "label": "Domain",
      "kind": "authority",
      "details": {
        "owns": "providers, models, families, recommendations, client selections and the team file",
        "imports": "the standard library only"
      },
      "files": ["internal/domain/", "manifests/", "go.mod"]
    },
    {
      "id": "platform",
      "label": "Platform",
      "kind": "boundary",
      "details": {
        "owns": "AIGW-owned paths, guarded file writes and their rollback, bounded child processes"
      },
      "files": ["internal/platform/"]
    }
  ],
