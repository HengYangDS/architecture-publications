  "views": [
    {
      "id": "overview",
      "title": "From a command to the client files",
      "question": "Which parts does a change pass through on the way?",
      "summary": "Synchronization plans each change through the adapter seam, which every client adapter implements, saves it to the configuration store and then applies it through the same seam. A failed change is compensated under guard.",
      "members": [
        "commands",
        "use-cases",
        "synchronization",
        "configuration-store",
        "adapter-seam",
        "codex",
        "claude-code",
        "claude-desktop",
        "hermes"
      ]
    },
    {
      "id": "authority",
      "title": "Who owns which state",
      "question": "Which owners hold the configuration, the Tokens and AIGW's own paths, and who reads them?",
      "summary": "The configuration store owns aigw.toml under one lock and the credential store the provider Tokens; Platform owns AIGW's own paths. The credential helper reads the providers and clients, then the Token that a client file's fingerprint names.",
      "members": [
        "commands",
        "credential-helper",
        "synchronization",
        "configuration-store",
        "credentials",
        "domain",
        "platform"
      ]
    },
    {
      "id": "adapters",
      "title": "Admitted clients and their seam",
      "question": "How are client adapters admitted, held to one contract and kept to guarded writes?",
      "summary": "Client admission admits clients by listing their built-in adapters in admission order; the program entry loads that list at start. Each adapter implements the adapter seam, held to one contract, and makes guarded writes through Platform.",
      "members": [
        "program-entry",
        "client-admission",
        "adapter-seam",
        "discovery",
        "codex",
        "claude-code",
        "claude-desktop",
        "hermes",
        "platform"
      ]
    },
    {
      "id": "readiness",
      "title": "What a command can report",
      "question": "Where does a command get the state and next action it reports?",
      "summary": "Activation classifies the enabled-client scope and selects the next action. Readiness reads health from Diagnostics to give a state such as configured or degraded; the depth that aigw check reached says how much was proven. Terminal renders the values from Use cases as human-readable or JSON output.",
      "members": [
        "commands",
        "use-cases",
        "activation",
        "readiness",
        "diagnostics",
        "synchronization",
        "terminal",
        "domain"
      ]
    },
    {
      "id": "program",
      "title": "The program itself",
      "question": "How does the program start, admit its clients and replace itself?",
      "summary": "The program entry starts Commands and loads the admitted clients from Client admission. The part Program updates finds signed releases on GitHub and GitLab and installs a portable program through Platform, keeping one predecessor.",
      "members": [
        "program-entry",
        "commands",
        "client-admission",
        "program-updates",
        "credential-helper",
        "credentials",
        "configuration-store",
        "platform"
      ]
    },
    {
      "id": "projection",
      "title": "One sync, discovery to compensation",
      "question": "Which part performs each step, and which compensates?",
      "summary": "Synchronization observes through Discovery, validates against Domain, plans through the adapter seam, saves to the configuration store and then applies through the seam; on failure it compensates from the receipt. Platform owns guarded file writes and their compensation.",
      "members": [
        "synchronization",
        "discovery",
        "adapter-seam",
        "domain",
        "configuration-store",
        "credentials",
        "platform"
      ]
    }
  ],
