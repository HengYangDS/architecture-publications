      ]
    },
    {
      "id": "discovery",
      "label": "Discovery",
      "kind": "observer",
      "details": {
        "observes": "the host's clients and paths without adopting them"
      },
      "files": ["internal/adapter/discovery/"]
    },
    {
      "id": "codex",
      "label": "Codex",
      "kind": "client",
      "details": {
        "writes": "a bounded region of ~/.codex/config.toml and its model catalog"
      },
      "files": ["internal/adapter/codex/"]
    },
    {
      "id": "claude-code",
      "label": "Claude Code",
      "kind": "client",
      "details": {
        "writes": "~/.claude/settings.json"
