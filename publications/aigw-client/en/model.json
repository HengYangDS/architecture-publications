{
  "format": "architecture-publisher.model",
  "version": 3,
  "id": "aigw-client",
  "locale": "en",
  "title": "AIGW Client Projection",
  "question": "How does AIGW turn one reviewed configuration into guarded client files in every admitted client?",
  "summary": "AIGW keeps providers, models and client selections in one locked configuration, aigw.toml, and its Tokens in one selected store. It writes AIGW's settings into each client's files through one adapter seam, as a guarded, compensated transaction. It never carries a request.",
  "scope": "The AIGW program as released at v0.7.0: its production Go packages, the command entry point, the team file and go.mod.",
  "limits": [
    "Each component cites every production file the rules attribute to it; a relation cites the files of the packages that import the other component.",
    "Tests, their inputs and the repository's tools, CI and documentation are outside the scope."
  ],
  "repository": {
    "name": "aigw-cli",
    "url": "https://github.com/HengYangDS/aigw-cli.git",
    "revision": "9bf7612c9678d6fc02eade0eda637be1b450af87",
    "browse": "https://github.com/HengYangDS/aigw-cli/blob/{revision}/{path}"
  },
  "coverage": {
    "include": ["cmd/", "internal/", "manifests/", "go.mod"],
    "exclude": [
      {
        "path": "**/*_test.go",
        "reason": "Go keeps each package's tests beside its code; they are not its architecture."
      },
      {
        "path": "cmd/aigw/testdata/",
        "reason": "Inputs of the command tests."
      }
    ]
  },
  "overview": "overview.typ",
  "guide": "guide/guide.archify.md",
  "kinds": {
    "interface": {
      "category": "frontend",
      "icon": "square-terminal"
    },
    "coordinator": {
      "category": "backend",
      "icon": "workflow"
    },
    "observer": {
      "category": "cloud",
      "icon": "radar"
    },
    "registry": {
      "category": "messagebus",
      "icon": "list-ordered"
    },
    "contract": {
      "category": "security",
      "icon": "file-cog"
    },
    "boundary": {
      "category": "security",
      "icon": "shield-check"
    },
    "authority": {
      "category": "database",
      "icon": "database"
    },
    "client": {
      "category": "external",
      "icon": "app-window"
    }
  },
  "components": [
