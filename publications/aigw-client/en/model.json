{
  "format": "architecture-publisher.model",
  "version": 3,
  "id": "aigw-client",
  "locale": "en",
  "title": "AIGW Client Projection",
  "question": "How does AIGW turn one reviewed configuration into guarded client files in every admitted client?",
  "summary": "Providers, models and client selections live in one configuration, aigw.toml, changed under one lock, and the provider Tokens in one selected store. Each client's files take only AIGW's own settings through one adapter seam, as a guarded, compensated transaction. No request passes through AIGW.",
  "scope": "The AIGW program as released at v0.8.3: its production Go packages, the command entry point, the team file manifests/team.toml and go.mod.",
  "limits": [
    "A component lists only the production files under the paths it claims, and a relation only the files of the packages that import the other component.",
    "Tests, their inputs and the repository's tools, CI and documentation are outside the scope."
  ],
  "repository": {
    "name": "aigw-cli",
    "url": "https://github.com/HengYangDS/aigw-cli.git",
    "revision": "fbec6f90d85951adbba853539efa0f8b3bc7c2fc"
  },
  "coverage": {
    "include": ["cmd/", "internal/", "manifests/", "go.mod"],
    "exclude": [
      {
        "path": "**/*_test.go",
        "reason": "Go keeps each package's tests beside its code; they are not its architecture."
      },
      {
        "path": "cmd/aigw/testdata/",
        "reason": "Inputs of the command tests."
      },
      {
        "path": "internal/adapter/hermes/testdata/",
        "reason": "Inputs of the Hermes adapter's tests."
      }
    ]
  },
  "overview": {
    "claim": "One reviewed configuration, projected into every client",
    "lead": "A local control plane: AIGW points each client at one model, writes only its own settings into the client's files, runs only for a command or a credential read, and never carries a request.",
    "course": {
      "steps": [
        {
          "id": "control",
          "label": "Control plane · AIGW",
          "note": "aigw.toml under one lock · Tokens kept apart",
          "stations": [
            {
              "id": "provider",
              "label": "Provider",
              "note": "a service the operator holds a Token for: one endpoint per protocol, never a credential"
            },
            {
              "id": "model",
              "label": "Model",
              "note": "what a provider serves, named provider/model, with its protocols"
            },
            {
              "id": "selection",
              "label": "Client selection",
              "note": "the model one admitted client uses"
            }
          ],
          "view": "authority"
        },
        {
          "id": "clients",
          "label": "Data plane · the clients",
          "note": "each client keeps its own state and calls its endpoint itself",
          "text": "plan · apply · check",
          "stations": [
            {
              "branches": [
                {
                  "id": "codex",
                  "label": "Codex",
                  "note": "~/.codex/config.toml · conversations, model metadata and the Desktop GUI stay with Codex"
                },
                {
                  "id": "claude-code",
                  "label": "Claude Code",
                  "note": "~/.claude/settings.json · sessions and runtime behaviour stay with Claude Code"
                },
                {
                  "id": "claude-desktop",
                  "label": "Claude Desktop",
                  "note": "Claude-3p/configLibrary · third-party inference; the rest stays with the app"
                },
                {
                  "id": "hermes",
                  "label": "Hermes",
                  "note": "~/.hermes/config.yaml · everything but AIGW's own providers and model stays with Hermes"
                }
              ]
            }
          ],
          "view": "adapters"
        },
        {
          "id": "endpoints",
          "label": "Endpoints",
          "note": "providers, or a chosen gateway",
          "text": "requests go straight to an endpoint; its product owns traffic normalization, retries and service lifecycle"
        }
      ],
      "lines": [
        {
          "from": "tokens",
          "to": ["codex", "claude-code", "claude-desktop", "hermes"],
          "label": "through aigw credential, each client reads on demand the provider Token that a fingerprint in its files names"
        }
      ],
      "spurs": [
        {
          "at": "provider",
          "id": "tokens",
          "label": "Tokens",
          "note": "keyring, DPAPI, owner-only file"
        },
        {
          "at": "model",
          "id": "family",
          "label": "Family",
          "note": "optional: which canonical model it is"
        }
      ],
      "passes": [
        {
          "after": "provider",
          "label": "serves"
        },
        {
          "after": "model",
          "label": "selected by"
        }
      ]
    },
    "blocks": [
      {
        "title": "What the operator does",
        "items": [
          [
            "setup",
            "start with one provider, one installed client and one of the provider's models"
          ],
          ["use", "point one client at one provider/model"],
          [
            "sync",
            "make every enabled client's files match; --dry-run shows the plan and reads no credential"
          ],
          [
            "check",
            "as deep as --depth asks: local, endpoint, model or client; model and client may use quota"
          ],
          ["provider rotate", "replace a provider's Token only once it accepts the new one"],
          ["config rollback", "roll back the configuration and the client files, not the program"]
        ],
        "view": "overview"
      },
      {
        "title": "States and check depths, on every surface",
        "items": [
          [
            "configured",
            "local prerequisites pass; the depth of a check says how much more is proven"
          ],
          [
            "local · endpoint",
            "a check without a request · one authenticated request that names no model"
          ],
          ["model · client", "one bounded inference request · a real client session"],
          ["deferred", "a client-file write or a credential postponed on purpose"],
          ["degraded", "still configured, with a recoverable problem"],
          ["invalid · unavailable", "unsafe to use · a required capability is missing"]
        ],
        "view": "readiness"
      },
      {
        "title": "Every change to client files is one guarded transaction",
        "stations": [
          {
            "id": "discover",
            "label": "Discover",
            "note": "admitted clients and their native paths"
          },
          {
            "id": "plan",
            "label": "Plan",
            "note": "complete before writing, credential-free"
          },
          {
            "id": "prepare",
            "label": "Prepare",
            "note": "each target's exact state before and after"
          },
          {
            "id": "commit",
            "label": "Commit"
          },
          {
            "id": "receipt",
            "label": "Receipt",
            "note": "one to compensate from"
          }
        ],
        "pass": {
          "after": "commit",
          "label": "all committed"
        },
        "aside": {
          "from": "commit",
          "label": "Compensation in reverse, AIGW's own write only; a drifted file is refused, never overwritten."
        },
        "view": "projection"
      },
      {
        "title": "Who owns what",
        "items": [
          ["AIGW configuration", "providers, models, recommendations and each client's selection"],
          ["Credential store", "the provider Tokens, kept in the one store AIGW chooses"],
          ["Client adapter", "AIGW's own settings in one admitted client's files"],
          ["The client", "conversations, memory, tools and GUI state"],
          ["Local Git and the Forges", "signed commits and tags; hosting, CI and release records"]
        ],
        "view": "authority"
      },
      {
        "title": "The program itself",
        "items": [
          ["self update · self rollback", "updates or rolls back only a portable program"],
          ["self uninstall", "removes AIGW's settings from client files, then the program"]
        ],
        "view": "program"
      },
      {
        "title": "Team files, no credentials · provider changes",
        "items": [
          [
            "setup --from team.toml · --dry-run",
            "applies a reviewed team file, overriding local models · previews it and writes nothing"
          ],
          ["provider edit", "changes an endpoint deliberately; no command renames a provider"]
        ]
      }
    ]
  },
  "guide": "guide/guide.archify.md",
