  "components": [
    {
      "id": "status-reader",
      "label": "Status reader",
      "kind": "service",
      "details": {
        "command": "ethos status",
        "answers": "role, gaps and next action"
      },
      "sources": [
        "surface.cli.root.inspection",
        "domain.inspection",
        "adapters.repo.status.workspace"
      ]
    },
    {
      "id": "commitment",
      "label": "Commitment",
      "kind": "service",
      "details": {
        "compiles": "the current OpenSpec Change",
        "resolves": "change, scope and authority"
      },
      "sources": [
        "adapters.admission.current.resolution",
        "adapters.openspec.commitment",
        "adapters.openspec.profile",
        "adapters.openspec.lifecycle.archive_transition"
      ]
    },
    {
      "id": "transition-plan",
      "label": "TransitionPlan",
      "kind": "service",
      "details": {
        "command": "ethos plan",
        "emits": "a digest-bound TransitionPlan"
      },
      "sources": [
        "surface.cli.root.planning",
        "domain.plan",
        "contracts.plan",
        "contracts.semantic"
      ]
    },
    {
      "id": "gate-policy",
      "label": "Gate policy",
      "kind": "service",
      "details": {
        "selects": "gates from .ethos/profile.toml"
      },
      "sources": [
        "adapters.repo.gate_policy",
        "repository.policy.gates",
        "repository.profile",
        "system.gates.toml"
      ]
    },
    {
      "id": "proof",
      "label": "Proof",
      "kind": "service",
      "details": {
        "command": "ethos prove",
        "runs": "the gate graph, bounded parallel",
        "issues": "proof:execution Attestation"
      },
      "sources": [
        "surface.cli.root.proof",
        "adapters.gates.runner",
        "adapters.mutation.proof",
        "adapters.mutation.proof_artifacts"
      ]
    },
    {
      "id": "work-lane",
      "label": "Work Lane",
      "kind": "service",
      "details": {
        "commands": "lane start, lane retire",
        "owns": ["start", "refresh", "archive-change", "retirement"]
      },
      "sources": [
        "surface.cli.lane.lifecycle",
        "adapters.mutation.lane_lifecycle.start",
        "adapters.mutation.lane_retirement.operation",
        "surface.cli.lane.retirement"
      ]
    },
    {
      "id": "prewrite-admission",
      "label": "Prewrite admission",
      "kind": "admission",
      "details": {
        "command": "ethos lane prewrite",
        "admits": "exact tracked write paths"
      },
      "sources": [
        "adapters.admission.prewrite",
        "adapters.admission.paths",
        "adapters.admission.patch_admission"
      ]
    },
    {
      "id": "lane-lease",
      "label": "Lane lease",
      "kind": "admission",
      "details": {
        "binds": "holder, generation and expiry",
        "state": "ethos/state.sqlite in the Git common directory"
      },
      "sources": [
        "adapters.admission.current.authority",
        "adapters.store.state.lease.lifecycle.transitions",
        "adapters.store.state.schema"
      ]
    },
    {
      "id": "hook-admission",
      "label": "Hook admission",
      "kind": "admission",
      "details": {
        "guards": "commits, pushes and ref moves"
      },
      "sources": [
        "adapters.repo.hook.protocol",
        "adapters.repo.hook.admission",
        "adapters.admission.transitions"
      ]
    },
    {
      "id": "mutation-admission",
      "label": "Mutation admission",
      "kind": "admission",
      "details": {
        "requires": "a proof Attestation at HEAD"
      },
      "sources": [
        "adapters.mutation.decision",
        "adapters.mutation.proof_admission",
        "contracts.admission"
      ]
    },
    {
      "id": "land-closeout",
      "label": "Land and closeout",
      "kind": "service",
      "details": {
        "command": "ethos land",
        "promotes": "candidate, then accepted branch"
      },
      "sources": [
        "surface.cli.root.land",
        "domain.land.operation",
        "adapters.mutation.landing",
        "adapters.mutation.accepted.promotion"
      ]
    },
    {
      "id": "git-effect-engine",
      "label": "Git effect engine",
      "kind": "service",
      "details": {
        "executes": "CAS update-ref with ref intents"
      },
      "sources": [
        "adapters.repo.git_effects",
        "adapters.repo.git_effect_observation",
        "adapters.repo.git_effect_admission",
        "adapters.admission.ref_intent"
      ]
    },
    {
      "id": "publication",
      "label": "Peer publication",
      "kind": "service",
      "details": {
        "command": "ethos publish",
        "pushes": "exact refs to peer remotes"
      },
      "sources": [
        "surface.cli.root.publish",
        "domain.publication.operation",
        "adapters.mutation.publication.execution"
      ]
    },
    {
      "id": "runtime-installer",
      "label": "Runtime installer",
      "kind": "service",
      "details": {
        "command": "ethos hook install",
        "activates": "runtime/CURRENT and hook launchers"
      },
      "sources": [
        "surface.cli.hook.commands",
        "adapters.repo.hook.activation",
        "adapters.repo.runtime.selection",
        "adapters.repo.hook.binding.toml"
      ]
    },
    {
      "id": "attestation-set",
      "label": "Attestation set",
      "kind": "store",
      "details": {
        "ref": "refs/ethos/attestations-set"
      },
      "sources": ["adapters.repo.attestation_set", "adapters.repo.git_effect_attestation"]
    },
    {
